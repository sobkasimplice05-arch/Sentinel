name: Sentinel Ouroboros H24

on:
  schedule:
    # Réveil automatique précis toutes les 60 minutes
    - cron: '0 * * * *'
  workflow_dispatch:
    # Vous permet de lancer une pulsation manuelle d'un clic sur GitHub si besoin

jobs:
  run-sentinel:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      workflows: write
    steps:
      - name: Restauration du dépôt
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Configuration de Python
        uses: actions/setup-python@v5
        with:
          python-python-version: '3.11'

      - name: Installation des dépendances stables
        run: |
          python -m pip install --upgrade pip
          pip install requests

      - name: Exécution de la Pulsation de Singularité
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          GOOGLE_API_KEY: ${{ secrets.GOOGLE_API_KEY }}
          SENTINEL_DISCORD_WEBHOOK: ${{ secrets.SENTINEL_DISCORD_WEBHOOK }}
        run: |
          export PYTHONPATH=.
          python3 src/core/self_audit.py
