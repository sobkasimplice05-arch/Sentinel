name: 🔥 Brutal Singularity - Level 1 (Self-Healing)

on:
  schedule:
    - cron: '*/30 * * * *'
  workflow_dispatch:

env:
  GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
  HF_API_KEY: ${{ secrets.HF_API_KEY }}
  REPLICATE_API_KEY: ${{ secrets.REPLICATE_API_KEY }}
  GOOGLE_API_KEY: ${{ secrets.GOOGLE_API_KEY }}

jobs:
  singularity-self-healing:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - uses: actions/checkout@v3
        with:
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.12'

      - name: Install deps
        run: pip install requests loguru asyncio -q

      - name: 🦙 Clean Ollama Setup
        run: |
          rm -rf /home/runner/.ollama 2>/dev/null || true
          pkill ollama 2>/dev/null || true
          curl -fsSL https://ollama.ai/install.sh | sh
          nohup ollama serve > ollama.log 2>&1 &
          sleep 3
          ollama pull qwen2.5:1.5b || true

      - name: 🔥 ACTIVATE WITH SELF-HEALING
        run: |
          export PYTHONPATH=.
          python3 << 'PYTHON'
import sys
sys.path.insert(0, '/workspaces/Sentinel')

from src.core.self_healing import SelfHealing
from src.core.self_audit import BrutalSingularityCore

print("="*60)
print("🔥 LEVEL 1 WITH SELF-HEALING")
print("="*60)

healing = SelfHealing()
core = BrutalSingularityCore()

try:
    core.run_autonomous_cycle()
    print("✅ Mutation successful")
except Exception as e:
    error_type = type(e).__name__
    error_msg = str(e)
    print(f"❌ Error: {error_type}")
    
    # Self-healing
    if "ssh" in error_msg.lower():
        healing.fix_ssh_conflict(error_msg)
    elif "timeout" in error_msg.lower():
        healing.fix_api_timeout(error_msg)
    elif "auth" in error_msg.lower() or "401" in error_msg:
        healing.fix_api_auth_failed(error_msg)
    elif "ollama" in error_msg.lower():
        healing.fix_ollama(error_msg)
    
    healing.log_solution(error_type, True)

print("="*60)
PYTHON

      - name: 📤 Push Changes
        run: |
          git config user.email "sentinel-self-healing@ouroboros.ai"
          git config user.name "Sentinel-Self-Healing"
          git add -A
          git commit -m "🔧 SELF-HEALING: Auto-corrected errors" || true
          git push origin main --force

